+ 	memory-region = <&global_cma>;
+
+ 	dr_mode = "otg";
+ 	status = "okay";
+};
+
+&ehci1 {
+ 	memory-region = <&global_cma>;
+
+ 	status = "okay";
+};
+
+&hsusb {
