@@ -597,6 +634,10 @@ static const struct of_device_id rcar_gen3_phy_usb2_match_table[] = {
 		.compatible = "renesas,rcar-gen3-usb2-phy",
 		.data = &rcar_gen3_phy_usb2_data,
 	},
+	{
+		.compatible = "renesas,rzv2h-usb2-phy",
+		.data = &rz_v2h_phy_usb2_data,
