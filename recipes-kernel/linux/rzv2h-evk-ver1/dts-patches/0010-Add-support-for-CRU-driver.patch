+ 		vdda-supply = <&ov5645_vdda_2v8>;
+ 		vddd-supply = <&ov5645_vddd_1v5>;
+ 		/* Set dummy enable gpio */
+ 		enable-gpios = <&gpio_dummy 1 GPIO_ACTIVE_HIGH>;
+ 		reset-gpios = <&pinctrl RZV2H_GPIO(6, 5) GPIO_ACTIVE_LOW>;
+ 
