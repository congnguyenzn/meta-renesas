diff --git a/arch/arm64/configs/defconfig b/arch/arm64/configs/defconfig
index 823eb5c01..f348107f8 100644
--- a/arch/arm64/configs/defconfig
+++ b/arch/arm64/configs/defconfig
@@ -171,6 +171,7 @@ CONFIG_SPI_RPCIF=y
 CONFIG_PINCTRL_SINGLE=y
 CONFIG_PINCTRL_DA9062=y
 CONFIG_GPIO_RCAR=y
+CONFIG_GPIO_DUMMY=y
 CONFIG_GPIO_PCA953X=y
 CONFIG_GPIO_PCA953X_IRQ=y
 CONFIG_GPIO_SYSFS=y
diff --git a/drivers/gpio/Kconfig b/drivers/gpio/Kconfig
index 1c28a4891..74223761e 100644
--- a/drivers/gpio/Kconfig
+++ b/drivers/gpio/Kconfig
@@ -562,6 +562,12 @@ config GPIO_RCAR
 	help
 	  Say yes here to support GPIO on Renesas R-Car or RZ/G SoCs.
 
+config GPIO_DUMMY
+ 	tristate "Renesas Dummy GPIO driver"
+ 	depends on ARCH_RENESAS || COMPILE_TEST
+ 	help
+ 	  Say yes here to build support for the Dummy GPIO.
+
 config GPIO_RDA
 	bool "RDA Micro GPIO controller support"
 	depends on ARCH_RDA || COMPILE_TEST
diff --git a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-core.c b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-core.c
index 4d499dae1..97bc5d123 100644
--- a/drivers/media/platform/renesas/rzg2l-cru/rzg2l-core.c
+++ b/drivers/media/platform/renesas/rzg2l-cru/rzg2l-core.c
@@ -73,6 +73,7 @@ static int rzg2l_cru_group_notify_complete(struct v4l2_async_notifier *notifier)
 		return ret;
 	}
 	cru->csi.channel = 0;
+	cru->svc_channel = cru->csi.channel;
 	cru->ip.remote = cru->csi.subdev;
 
 	/* Create media device link between CRU IP <-> CRU OUTPUT */
@@ -242,6 +243,24 @@ static int rzg2l_cru_media_init(struct rzg2l_cru_dev *cru)
 	if (ret)
 		return ret;
 
+	if (cru->info->max_cru_channels > 1) {
+		ret = of_property_read_u32(cru->dev->of_node, "channel,id", &cru->id);
+		if (ret) {
+			if (cru->info->cru_type == RZV2H_CRU_TYPE) {
+				dev_err(cru->dev, "%pOF: No channel,id property found\n",
+						cru->dev->of_node);
+				return -EINVAL;
+			}
+			cru->id = 0;
+		}
+	}
+
+	if (cru->id >= cru->info->max_cru_channels) {
+		dev_err(cru->dev, "%pOF: Invalid channel,id '%u'\n",
+			cru->dev->of_node, cru->id);
+		return -EINVAL;
