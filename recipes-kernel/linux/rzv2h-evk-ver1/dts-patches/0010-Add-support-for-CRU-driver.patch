+ 			 <RZV2H_PORT_PINMUX(4, 7, 1)>; /* I2C7_SCL */
+ 	};
+
 	usb30_pins: usb30 {
 		pinmux = <RZV2H_PORT_PINMUX(B, 0, 14)>; /* VBUS */
 	};
@@ -324,6 +389,188 @@ phy1: ethernet-phy@0 {
 	};
 };
 
+&i2c0 {
