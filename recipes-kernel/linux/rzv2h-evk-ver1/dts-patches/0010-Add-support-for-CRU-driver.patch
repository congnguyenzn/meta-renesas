+ 		clocks = <&ov5645_fixed_clk>;
+ 		clock-frequency = <24000000>;
+ 		vdddo-supply = <&ov5645_vdddo_1v8>;
+ 		vdda-supply = <&ov5645_vdda_2v8>;
+ 		vddd-supply = <&ov5645_vddd_1v5>;
+ 		enable-gpios = <&pinctrl RZV2H_GPIO(6, 1) GPIO_ACTIVE_HIGH>;
+ 		reset-gpios = <&pinctrl RZV2H_GPIO(9, 2) GPIO_ACTIVE_LOW>;
+ 
+ 		port {
+ 			ov5645_to_csi22: endpoint {
+ 				clock-lanes = <0>;
+ 				data-lanes = <1 2>;
+ 				remote-endpoint = <&csi22_in>;
+ 			};
+ 		};
+ 	};
+};
