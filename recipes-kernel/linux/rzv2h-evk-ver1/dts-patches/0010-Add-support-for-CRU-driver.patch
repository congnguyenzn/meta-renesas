+ 				data-lanes = <1 2>;
+ 				remote-endpoint = <&ov5645_to_csi20>;
+ 			};
+ 		};
+ 	};
+};
+ 
+&cru1 {
+ 	status = "okay";
+};
+ 
+&csi21 {
+ 	status = "disabled";
+ 
+ 	ports {
+ 		port {
+ 			csi21_in: endpoint {
+ 				clock-lanes = <0>;
+ 				data-lanes = <1 2>;
+ 				remote-endpoint = <&ov5645_to_csi21>;
+ 			};
+ 		};
+ 	};
+};
+ 
+&cru2 {
+ 	status = "okay";
+};
+ 
+&csi22 {
+ 	status = "disabled";
+ 
+ 	ports {
+ 		port {
+ 			csi22_in: endpoint {
+ 				clock-lanes = <0>;
+ 				data-lanes = <1 2>;
+ 				remote-endpoint = <&ov5645_to_csi22>;
+ 			};
+ 		};
+ 	};
+};
